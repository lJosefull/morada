{
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/properties/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Pinterest|Discordbot|Slack|Googlebot|Google-PageRenderer|bot|crawl|preview).*"
        }
      ],
      "destination": "/api/og/:id"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
