# =============================================================================
# ⚠️  IMPORTANTE: Copia este archivo a .env y completa los valores
# =============================================================================
# ¡NO subas .env al repositorio! Contiene secretos de producción.

# --- AI (al menos una API Key requerida para generación de descripciones) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
AI_MODEL=deepseek/deepseek-chat

# --- Base de Datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate?schema=public

# --- JWT: Cámbialas antes de producción — usa `openssl rand -base64 32` ---
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-me-to-another-random-secret-in-production

# --- App ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
