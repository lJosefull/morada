# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/realestate?schema=public

# JWT
JWT_SECRET=change-me-to-a-random-64-char-hex
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Altcha (bot protection)
ALTCHA_HMAC_KEY=change-me-to-a-random-64-char-hex

# Server
PORT=3000
NODE_ENV=production
