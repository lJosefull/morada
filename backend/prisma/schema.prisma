generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  googleId          String?  @unique
  emailVerified     Boolean  @default(false)
  verificationToken String?
  role              String   @default("user")
  plan              String   @default("free")
  agencyName String?
  agencyLogo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties    Property[]
  refreshTokens RefreshToken[]
  inquiries     Inquiry[]
  propertyViews PropertyView[]
  favorites     Favorite[]
  reviews       Review[]
  notifications Notification[]
  followers     UserFollow[] @relation(name: "followers")
  following     UserFollow[] @relation(name: "follows")
}

model Property {
  id           String   @id @default(cuid())
  title        String
  description  String
  price        Float
  currency     String   @default("COP")
  propertyType String
  listingType  String
  bedrooms     Int?
  bathrooms    Int?
  surface      Float?
  surfaceUnit  String   @default("m²")
  location     String
  latitude     Float?
  longitude    Float?
  status       String   @default("available")
  aiTitle      String?
  aiDescription String?
  aiStatus     String   @default("pending")
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User    @relation(fields: [userId], references: [id])
  images         Image[]
  inquiries      Inquiry[]
  propertyViews  PropertyView[]
  dailyStats     DailyPropertyStats[]
  favorites      Favorite[]
  reviews        Review[]
}

model Image {
  id         String   @id @default(cuid())
  url        String
  filename   String
  mimetype   String
  size       Int
  isPrimary  Boolean  @default(false)
  propertyId String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Inquiry {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  email       String
  phone       String?
  message     String
  status      String   @default("new")
  notes       String?
  ownerUserId String
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  statusChanges InquiryStatusChange[]

  @@index([ownerUserId, status])
  @@index([propertyId])
}

model InquiryStatusChange {
  id         String   @id @default(cuid())
  inquiryId  String
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  ip         String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
}

model DailyPropertyStats {
  id             String   @id @default(cuid())
  propertyId     String
  date           DateTime
  views          Int      @default(0)
  uniqueViews    Int      @default(0)
  inquiriesCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([propertyId, date])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Review {
  id         String     @id @default(cuid())
  propertyId String
  userId     String
  rating     Int
  comment    String
  reply      String?    // Owner's reply to this review
  replyDate  DateTime?  // When the owner replied
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // inquiry_new, review_new, follow, etc.
  title     String
  message   String
  link      String?  // URL to navigate to
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   // user who follows
  followingId String   // user being followed
  createdAt   DateTime @default(now())

  follower  User @relation(name: "follows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation(name: "followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
